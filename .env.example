# ============================================================
# CertIQ — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# === GitHub Models (Model Inference) ===
# Get a PAT from https://github.com/settings/tokens
# Required scope: models:read
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODEL_PRIMARY=openai/gpt-4o
GITHUB_MODEL_LITE=openai/gpt-4o-mini

# === Azure AI Search (Foundry IQ — Knowledge Grounding) ===
# Free tier in Central India
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-admin-key-here
AZURE_SEARCH_INDEX_NAME=certiq-knowledge

# === Azure Blob Storage (Knowledge Base Documents) ===
# Standard LRS in Central India
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourname;AccountKey=yourkey==;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=org-knowledge

# === Application Settings ===
CONFIDENCE_THRESHOLD=0.65
PLAN_HEALTH_ESCALATION_THRESHOLD=0.6
PLAN_HEALTH_ESCALATION_WEEKS=2
LOG_LEVEL=INFO

# === API Settings ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
